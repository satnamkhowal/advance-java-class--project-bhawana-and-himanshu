package abc.xyz;

public class MethodOverLoadingEx {
	public static void main(String[] args) {
		Dog d=new Dog();
		d.eat();
		d.bark();
	}
}

class Animal{
	public void eat() {
		System.out.println("Animal is eating");
	}
}
class Dog extends Animal{
	
	
	public void eat() {
		System.out.println("Dog is eating bread");
	}
	
	public void bark() {
		System.out.println("Dog is barking");
	}
}