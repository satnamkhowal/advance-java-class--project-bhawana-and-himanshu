package com.groot.interfaceex;

public class Test {
		public static void main(String[] args) {
			Z z=new Z();
			z.display();
			z.say();
			System.out.println(X.a);
			X.a=20;
		}
}
interface X{
	int a=10;
	public void say();
	public void display();

}
abstract class Y implements X{

	@Override
	public void say() {
		// TODO Auto-generated method stub
		System.out.println("I am Say method");
	}
	
}
class Z extends Y{

	@Override
	public void display() {
		// TODO Auto-generated method stub
		System.out.println("Display Method of class Z");
	}
	
}